{
  "name": "erp",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:setup": "turbo run build --filter=@erp/db --filter=@erp/shared && pnpm --filter @erp/db migrate && pnpm --filter @erp/db seed:regions",
    "db:migrate": "pnpm --filter @erp/db migrate",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "platform:admin": "pnpm --filter @erp/db platform:admin",
    "demo:excel": "turbo run build --filter=@erp/demo-data && pnpm --filter @erp/demo-data excel",
    "demo:load": "turbo run build --filter=@erp/demo-data && pnpm --filter @erp/demo-data load --"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}

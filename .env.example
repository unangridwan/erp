DATABASE_URL=postgres://erp:erp@localhost:5432/erp
REDIS_URL=redis://localhost:6379
PORT=3001
# Masing-masing minimal 32 karakter acak; jangan pakai nilai yang sama.
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-32
ENCRYPTION_KEY=ganti-dengan-string-acak-lain-minimal-32-karakter
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
# Mailpit dari docker-compose (UI di http://localhost:8025); "json" = tidak mengirim
MAIL_TRANSPORT=smtp://localhost:1025
MAIL_FROM=ERP <no-reply@erp.local>

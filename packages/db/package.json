{
  "name": "@erp/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./load-env": {
      "types": "./dist/load-env.d.ts",
      "default": "./dist/load-env.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "default": "./dist/migrate.js"
    },
    "./seed-regions": {
      "types": "./dist/seed-regions.d.ts",
      "default": "./dist/seed-regions.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node dist/bin/migrate.js",
    "test": "vitest run",
    "seed:regions": "node dist/bin/seed-regions.js",
    "platform:admin": "node dist/bin/platform-admin.js"
  },
  "dependencies": {
    "@erp/shared": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@types/node": "^22.10.2",
    "vitest": "^2.1.8"
  }
}
